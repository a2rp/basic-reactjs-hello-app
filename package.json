{
    "name": "basic-reactjs-hello-app",
    "version": "1.0.0",
    "description": "A responsive React starter app with a live browser date and time display",
    "private": true,
    "author": "Ashish Ranjan",
    "license": "MIT",
    "dependencies": {
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-icons": "^5.7.0",
        "react-scripts": "5.0.1"
    },
    "scripts": {
        "start": "react-scripts start",
        "lint": "eslint src --ext .js --max-warnings=0",
        "build": "react-scripts build",
        "eject": "react-scripts eject",
        "predeploy": "npm run build",
        "deploy": "gh-pages -d build"
    },
    "homepage": "https://a2rp.github.io/basic-reactjs-hello-app/",
    "devDependencies": {
        "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
        "gh-pages": "^6.3.0"
    },
    "eslintConfig": {
        "extends": [
            "react-app"
        ]
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    }
}
